APP_ENV=homologation
PAYMENTS_MODE=SANDBOX
# BRAVOPAY usa API real quando configurado. Não ativar antes da liberação institucional.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/homologation.sqlite
DATA_ENCRYPTION_KEY=
SANDBOX_WEBHOOK_SECRET=
# Em BRAVOPAY: base oficial https://bravopay.club/api/v1 (sem barra final).
BRAVOPAY_BASE_URL=
# Reservada; a API fornecida não utiliza public key.
BRAVOPAY_PUBLIC_KEY=
# API key Bearer bp_live_...; nunca usar no navegador.
BRAVOPAY_SECRET_KEY=
# Secret whsec_... gerado para o webhook no Dashboard.
BRAVOPAY_WEBHOOK_SECRET=
